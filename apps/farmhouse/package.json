{
  "name": "@agritainment/farmhouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:h5": "uni -p h5 --host 127.0.0.1",
    "build:h5": "uni build -p h5 --mode shibanxi",
    "build:mp-weixin": "uni build -p mp-weixin --mode shibanxi",
    "build:h5:yunshang": "uni build -p h5 --mode yunshang && node ../../scripts/copy-tenant.mjs yunshang h5 && uni build -p h5 --mode shibanxi",
    "build:mp:yunshang": "uni build -p mp-weixin --mode yunshang && node ../../scripts/copy-tenant.mjs yunshang mp-weixin && uni build -p mp-weixin --mode shibanxi",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@agritainment/shared": "workspace:*",
    "@agritainment/ui": "workspace:*",
    "@dcloudio/uni-app": "3.0.0-5020320260806002",
    "@dcloudio/uni-components": "3.0.0-5020320260806002",
    "@dcloudio/uni-h5": "3.0.0-5020320260806002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020320260806002",
    "pinia": "2.2.0",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020320260806002",
    "sass": "^1.89.0",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.10"
  }
}
